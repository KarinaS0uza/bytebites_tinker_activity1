        +setName(name: String) boolean
        +getOrderCount() int
        +getOrder(index: int) Order
        +placeOrder(order: Order) boolean
        +browseMenu(menu: Menu, category: String) MenuItem[]
        +verifyUser() boolean
    }
    class Menu {
        -MenuItem[] items
        -int itemCount
        +int MAX_ITEMS$
        +Menu()
