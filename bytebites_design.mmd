        +filterByCategory(category: String) MenuItem[]
        +sortByPopularity() MenuItem[]
    }
    class MenuItem {
        -String name
        -double price
        -String category
        -double popularityRating
        +int MIN_NAME_LENGTH$
        +int MAX_NAME_LENGTH$
        +int MIN_CATEGORY_LENGTH$
        +int MAX_CATEGORY_LENGTH$
        +double MIN_PRICE$
        +double MAX_PRICE$
        +double MIN_POPULARITY_RATING$
        +double MAX_POPULARITY_RATING$
        +String DEFAULT_NAME$
        +double DEFAULT_PRICE$
        +String DEFAULT_CATEGORY$
        +double DEFAULT_POPULARITY_RATING$
        +MenuItem(name: String, price: double, category: String, popularityRating: double)
        +getName() String
        +getPrice() double
        +getCategory() String
        +getPopularityRating() double
        +setName(name: String) boolean
        +setPrice(price: double) boolean
        +setCategory(category: String) boolean
        +setPopularityRating(popularityRating: double) boolean
    }
    class Order {
        -MenuItem[] items
        -int itemCount
        +int MAX_ITEMS$
        +Order()
        +getItemCount() int
        +getItem(index: int) MenuItem
        +addItem(item: MenuItem) boolean
        +calculateTotal() double
    }

    Customer "1" --> "0..*" Order : places
    Customer ..> Menu : browses
    Menu "1" *-- "0..*" MenuItem : contains
    Order "*" o-- "1..*" MenuItem : includes
